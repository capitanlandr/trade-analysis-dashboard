# Fantasy Football Dashboard - Frontend Configuration
# Copy this file to .env for local development
# See: https://vitejs.dev/guide/env-and-mode.html

# Google Drive Configuration (for Commish Tiers Archive)
# The folder ID from Google Drive URL: https://drive.google.com/drive/folders/{FOLDER_ID}
# Note: Folder ID is public - access control managed by Google Drive sharing settings
VITE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ---------------------------------------------------------------------------
# Lambda API Toggle (Task 2.5 -- AWS Migration)
# ---------------------------------------------------------------------------
# Set to "true" to fetch data from the API Gateway Lambda endpoints.
# Any other value (or omitted) defaults to static JSON files in /public/.
# Default: false (static JSON -- existing behavior)
# VITE_USE_LAMBDA_API=false

# API Gateway base URL (only used when VITE_USE_LAMBDA_API=true)
# Default: https://aucuc2yvd4.execute-api.us-east-1.amazonaws.com/Prod
# VITE_API_BASE_URL=https://aucuc2yvd4.execute-api.us-east-1.amazonaws.com/Prod
