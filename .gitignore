# Pipeline data (CSV files that change frequently)
pipeline_outputs/*.csv
data/*.csv

# But keep example/template files
!pipeline_outputs/.gitkeep
!pipeline_outputs/example_*.csv
!data/example_*.csv

# Generated dashboard JSON files (rebuilt by pipeline)
dashboard/frontend/public/api-*.json
dashboard/frontend/public/playoff_*.json
dashboard/frontend/public/*_analysis.json

# Keep example files for documentation
!dashboard/frontend/public/api-*.example.json
!dashboard/frontend/public/README.md

# Pipeline intermediate files (don't commit these)
pipeline/backups/
pipeline/logs/
pipeline/metrics/
pipeline/__pycache__/
pipeline/**/__pycache__/
pipeline/*.pyc
pipeline/**/*.pyc

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# AWS credentials and sensitive setup files (DO NOT COMMIT)
AWS_ACCOUNT_SETUP_CHECKLIST.md
DEPLOYMENT_SUMMARY.md
GITHUB_SECRETS_SETUP.md
AWS_SETUP_PERSONAL_ACCOUNT.md

# Preseason poll: credentials and personal links stay local.
# token.json holds a live OAuth refresh token; prefill_links.csv and
# responses_raw.json contain league members' identities and picks.
poll/.venv/
poll/token.json
poll/prefill_links.csv
poll/responses_raw.json
poll/__pycache__/
